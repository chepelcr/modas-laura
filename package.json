{
  "name": "modas-laura",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio oficial de Modas Laura, Costa Rica",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "lint": "eslint src scripts vite.config.js",
    "test": "node --test tests/site.test.mjs",
    "check": "npm run lint && npm test",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts *.js *.html */index.html"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.2"
  },
  "type": "module"
}
